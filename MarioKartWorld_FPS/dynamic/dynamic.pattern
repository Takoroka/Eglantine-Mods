# Mario Kart World: let the game pick its 30 or 60 FPS mode by the whole frame time.
# Same site as the 30 FPS patch; the frame-mode load becomes mov w8, #0 (the game's automatic
# mode). Within the next 31 words, the one ldr xN, [x19, #0x128] (CPU-only frame time) becomes
# ldr xN, [x19, #0xE8] (whole frame time, including the GPU wait), keeping its register.
# Both writes are one patch: if either site isn't found, nothing changes.
# From Franz (FZout), Eglantine PR #403, based on the approach in PokeDinner 2.5.0.

[Dynamic FPS]
module = main
pattern = 6B01013F 54000001/FF00001F B9421268 35000008/FF00001F
near = 4..9 52A84E08
count = 1
write = 2 52800008
find = 3..33 F9409660/FFFFFFE0
write = 0 F9407660/FFFFFFE0
