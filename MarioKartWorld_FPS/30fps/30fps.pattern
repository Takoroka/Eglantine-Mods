# Mario Kart World: always use the native 30 FPS mode.
# The main loop loads its frame mode with ldr w8, [x19, #0x210] right after a cmp w9, w1 / b.ne
# and before a cbnz w8, with mov w8, #60.0f a few words later. That load becomes mov w8, #2.
# From Franz (FZout), Eglantine PR #403.

[30 FPS mode]
module = main
pattern = 6B01013F 54000001/FF00001F B9421268 35000008/FF00001F
near = 4..9 52A84E08
count = 1
write = 2 52800048
